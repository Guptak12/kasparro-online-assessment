# Gemini is optional at runtime; deterministic fallback is used without a key.
LLM_ENABLED=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONCURRENCY=2
LLM_MAX_INPUT_CHARACTERS=30000

GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28
GITHUB_TIMEOUT_SECONDS=10
GITHUB_MAX_CONCURRENCY=5
GITHUB_SECURITY_SCAN_ENABLED=true
GITHUB_SECURITY_MAX_REPOSITORIES=3
GITHUB_SECURITY_MAX_FILES_PER_REPOSITORY=10
GITHUB_SECURITY_MAX_FILE_BYTES=200000
GITHUB_SECURITY_REQUEST_RESERVE=200

MAX_RESUME_BYTES=10000000
MAX_RESUME_CHARACTERS=50000
RECURSIVE_DISCOVERY=false
LOG_LEVEL=INFO
